# Copy to .env and fill secrets. Do NOT commit .env.

DIFY_BASE_URL=http://127.0.0.1:7000
DIFY_API_KEY=app-xxxxxxxx
# 智能体名启动时从 GET /v1/info 读取；也可在 /admin 登记多个 Key

ASR_URL=http://127.0.0.1:8100

# TTS：4 Worker（每 GPU 2 路），HTTP 整段合成为主路径
TTS_HTTP_URLS=http://127.0.0.1:8200,http://127.0.0.1:8201,http://127.0.0.1:8202,http://127.0.0.1:8203
TTS_WS_URLS=ws://127.0.0.1:8200/internal/tts/stream,ws://127.0.0.1:8201/internal/tts/stream,ws://127.0.0.1:8202/internal/tts/stream,ws://127.0.0.1:8203/internal/tts/stream
MAX_TTS_ACTIVE_JOBS=4

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

HOST=0.0.0.0
PORT=8000
DEFAULT_AVATAR_ID=avatar_001
DEFAULT_AVATAR_VERSION_ID=avv_001
DEFAULT_VOICE_ID=avatar_voice_001
MEDIA_IDLE_TIMEOUT_S=90
TTS_SAMPLE_RATE=24000
