# cp .env.example .env 后只改下面几项。智能体 API Key 只在 /admin 添加。

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# 可选：管理端添加智能体时的默认 Base URL
DIFY_BASE_URL=http://127.0.0.1:7000

# 可选覆盖（默认已在代码里）
# ASR_HTTP_URLS=http://127.0.0.1:8100,http://127.0.0.1:8101
# TTS_HTTP_URLS=http://127.0.0.1:8300,http://127.0.0.1:8301
# MAX_ASR_JOBS=4
# MAX_TTS_ACTIVE_JOBS=8
