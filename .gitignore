# secrets & local env
.env
.env.*
!.env.example

# local caches / IDE bulk
.cache/
*.whl
nohup.out
*.pid

# cursor: keep shared rules, drop local junk
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# logs / runtime
*.log
data/temp/
data/temp_audio/
data/bench/
data/nginx_public_ip.txt
apps/api/data/
asr/data/temp_audio/

# agent registry holds real Dify API keys — never commit
data/agents/

# avatar: keep registry.json only; packages are uploaded via /admin
data/avatars/avatar_*/
data/avatars/uploads/
data/avatars/_src/
data/avatars/**/frames/
data/avatars/**/idle_frames/
data/avatars/**/talk_frames/
data/avatars/**/*.mp4
data/avatars/**/*.webm
data/avatars/**/*.mov

# TTS (legacy CosyVoice path) heavy deps & models
tts/models/
tts/CosyVoice/
**/modelscope_cache/
tts/data/*.wav

# Qwen TTS: commit code only — models/cache/bench/wav live under data/
tts_qwen/data/*
!tts_qwen/data/.gitkeep

# LiveKit runtime keys file (use example instead)
deploy/livekit/livekit.yaml

# ssl private keys if ever copied into repo
*.pem
*.key
!**/public*.pem
/ssl/

# ide / os
.idea/
.vscode/
.DS_Store
*.swp
Thumbs.db
